# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: models to try if the first is rate-limited (comma-separated)
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
# Tiger Data connection string (Tiger Cloud console -> your service -> Connect).
# Pasting TIMESCALE_SERVICE_URL=... from the downloaded Tiger .env also works.
DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
# Shared secret; put the same value in GAME_KEY in src/server/Bedtime.server.luau
GAME_API_KEY=
# Any random string; used to hash Roblox user ids before storing them
PLAYER_SALT=
# Optional: Barb's voice (ElevenLabs -> Developers -> API Keys)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=FGY2WhTYpPnrIDTdsKH5
